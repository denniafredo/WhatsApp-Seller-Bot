WPP_SESSION=business-bot
BUSINESS_PHONE=6281234567890
WELCOME_MENU_MODE=list
TEXT_MENU_FALLBACK=false
PUPPETEER_HEADLESS=true
CHROME_PATH=
GOOGLE_SHEET_ID=1p1fULilLrZHNhIICW3qM4lF76YT3lSDXBGP4852OOvw
GOOGLE_SHEET_NAME=Template pembayaran
GOOGLE_SHEET_GID=1828439131
RECAP_FORMAT=jpg
RECAP_TIMEZONE=Asia/Makassar
# --- Ringkasan rekap ke grup lain ---
# Setelah "rekap" selesai, bot mengirim dua baris (kulakan + kas) ke grup ini.
REKAP_SUMMARY_ENABLED=true
REKAP_SUMMARY_GROUP_NAME=booot
# Isi kalau nama grup ambigu; lebih pasti daripada mencocokkan nama.
REKAP_SUMMARY_GROUP_ID=
REKAP_SUMMARY_TOTAL_LABEL=kulakan yohan
REKAP_SUMMARY_CASH_LABEL=kas
# --- Sinyal crypto MA Squeeze harian (Indodax) ---
# Bot menjalankan screener Python di project tradingview lalu mengirim
# laporannya ke grup ini tiap hari. Manual: mention bot + "signal squeeze" di grup.
SQUEEZE_SIGNAL_ENABLED=true
SQUEEZE_SIGNAL_GROUP_NAME=cstv
# Isi kalau nama grup ambigu; lebih pasti daripada mencocokkan nama.
SQUEEZE_SIGNAL_GROUP_ID=
# Candle daily Indodax tutup 07:00 WIB; kirim setelahnya.
SQUEEZE_SIGNAL_TIME=07:10
SQUEEZE_SIGNAL_TIMEZONE=Asia/Jakarta
# Kosong = ../tradingview/screener/indodax_squeeze_screener.py
SQUEEZE_SCREENER_PATH=
# Kosong = python (Windows) / python3 (Linux)
SQUEEZE_PYTHON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Shopee Open API v2 — production: https://partner.shopeemobile.com
SHOPEE_HOST=https://partner.shopeemobile.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=
SHOPEE_SHOP_ID=
# Dipakai sebagai seed awal saja; token yang dipakai runtime disimpan di data/shopee-token.json
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_SHEET_NAME=Harga Shopee
HARGA_TERBARU_SHEET_NAME=Harga Terbaru
# Status produk yang ditarik saat npm run ambil:harga — NORMAL, UNLIST, BANNED, REVIEWING
SHOPEE_IMPORT_ITEM_STATUS=NORMAL,UNLIST
# Noise reduction video — engine: arnndn (AI/RNNoise, default) atau afftdn
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=
VIDEO_DENOISE_ENGINE=arnndn
VIDEO_DENOISE_MODEL=./assets/sh.rnnn
# 1 = denoise penuh, 0.85 menyisakan 15% sinyal asli supaya suara tidak terdengar hampa
VIDEO_DENOISE_MIX=1
VIDEO_DENOISE_POLISH=false
# Pulihkan kecerahan kalau suara terdengar berat/tumpul: coba 3 atau 5
VIDEO_DENOISE_TREBLE=0
# Hanya dipakai engine afftdn
VIDEO_DENOISE_NR=12
VIDEO_DENOISE_LOUDNORM=true
# Batas atas bitrate audio hasil; sumber di bawah nilai ini tidak akan dinaikkan
VIDEO_DENOISE_AUDIO_KBPS=128
VIDEO_MAX_MB=16
VIDEO_MAX_OUTPUT_MB=16
VIDEO_JOB_TIMEOUT_MS=300000
# DeepFilterNet (engine=deepfilternet) — binary di bin/, tidak di-commit
DEEPFILTER_PATH=
# 100 = penekanan penuh, turunkan (mis. 25) kalau hasilnya terdengar tidak natural
VIDEO_DENOISE_ATTEN_DB=100
VIDEO_DENOISE_DFN_POSTFILTER=false
# post-filter beta DeepFilterNet: default 0.02, naikkan (0.05/0.10/0.20) kalau
# kurang bersih. Cek pakai telinga lewat npm run uji:noise, bukan cuma angka.
VIDEO_DENOISE_DFN_PF_BETA=0.02
# voicecleaner.ai (engine=voicecleaner). Situsnya wajib login dan memakai kredit
# harian, jadi fitur berhenti saat kuota habis. Isi VOICECLEANER_FALLBACK_ENGINE
# supaya bot tetap membalas hasil saat itu terjadi; kosongkan untuk mematikannya.
VOICECLEANER_EMAIL=
VOICECLEANER_PASSWORD=
VOICECLEANER_FALLBACK_ENGINE=deepfilternet
VOICECLEANER_ENHANCEMENT=Remove Noise
VOICECLEANER_TIMEOUT_MS=300000
# true = jalan tanpa jendela. Set false saat memperbaiki selektor supaya kelihatan.
VOICECLEANER_HEADLESS=true

# ===== Cek kilo (bandingkan foto catatan karyawan dengan report Bilas) =====
# Login pemilik ke aplikasi Bilas (web.bilas.id)
BILAS_USERNAME=
BILAS_PASSWORD=
# Cabang default bila perintah tidak menyebut cabang:<nama>. Kosong = outlet pertama.
BILAS_DEFAULT_OUTLET=
# Pembacaan foto pakai Claude vision via AWS Bedrock
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opsional bila pakai kredensial sementara (STS)
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Selisih kg yang masih dianggap cocok (default 0.3 kg)
KILO_TOLERANCE=0.3
# Batas ukuran foto masuk (MB)
KILO_MAX_MB=12

# --- Cek ongkir (otomasi aplikasi Maxim di emulator MuMuPlayer) ---
# Folder yang memuat MuMuManager.exe dan adb.exe
MUMU_DIR=C:\Program Files\Netease\MuMuPlayer\nx_main
# Nomor VM di MuMuPlayer (lihat MuMuManager.exe info -v <n>)
MUMU_VM_INDEX=0
# Batas tunggu emulator menyala dari kondisi mati (ms)
MUMU_BOOT_TIMEOUT_MS=180000
# Paket aplikasi Maxim dan nama kategori yang dibuka
MAXIM_PACKAGE=com.taxsee.taxsee
MAXIM_CATEGORY=Delivery
# Kota yang dipilih saat Maxim menanyakannya (emulator mengira dirinya di Jakarta)
MAXIM_CITY=Semarang
# Batas tunggu membuka link Google (ms)
ONGKIR_LINK_TIMEOUT_MS=20000
# Menu titik jemput: list (menu WhatsApp) atau text (daftar bernomor)
ONGKIR_MENU_MODE=list
# Umur sesi tanya-jawab cek ongkir sebelum kedaluwarsa (ms)
ONGKIR_SESSION_TTL_MS=600000
# Alias titik asal -> kata kunci yang diketik ke pencarian Maxim.
# Nama alias diambil dari bagian setelah ONGKIR_ORIGIN_ (huruf kecil).
ONGKIR_ORIGIN_DASHMALL=Dash Mall Sterofoam
ONGKIR_ORIGIN_GUDANG=Kukilo Mukti Raya 143

# ===== Auto rekap (pemasukan harian Shopee + setoran offline -> Google Sheet) =====
# Perintah: mention bot + "auto rekap" (boleh "auto rekap kemarin" /
# "auto rekap tgl:2026-09-15" / "auto rekap tanpa shopee").
#
# --- Spreadsheet keuangan (TERPISAH dari GOOGLE_SHEET_ID) ---
# Share spreadsheet ini ke GOOGLE_SERVICE_ACCOUNT_EMAIL sebagai Editor dulu.
KEUANGAN_SHEET_ID=
# BIARKAN KOSONG. Tabnya per bulan ("September 2026") dan namanya tidak selalu
# konsisten ("Feb 2026"), jadi tab dicocokkan otomatis dari tanggalnya terhadap
# daftar tab sungguhan. Isi hanya kalau mau memaksa satu tab tertentu.
KEUANGAN_SHEET_NAME=
# Keterangan di kolom B yang dikenali/ditulis. Pencocokan tidak peduli
# huruf besar-kecil, jadi "offline" dan "Offline" dianggap sama.
KEUANGAN_SHOPEE_LABEL=Income Shopee
KEUANGAN_OFFLINE_LABEL=Offline
# Kolom D (pengeluaran). Kulakan & kas dibaca dari ringkasan rekap di grup;
# "Pengeluaran" dipakai untuk catatan lepas yang diketik orang di grup.
KEUANGAN_KULAKAN_LABEL=Kulakan Yohan
KEUANGAN_KAS_LABEL=Kas
KEUANGAN_PENGELUARAN_LABEL=Pengeluaran
# Jumlah baris header di atas data
KEUANGAN_HEADER_ROWS=1
# Batas baris yang ditelusuri saat mencari blok tanggal
KEUANGAN_LAST_ROW=1000
#
# --- Grup sumber setoran offline & pengeluaran ---
# Template yang dibaca: "offline <angka>" (masuk) dan "pengeluaran <angka>"
# (keluar). Angka tanpa satuan: KELIPATAN 1000 dibaca apa adanya ("85000" =
# Rp85.000), sisanya dikali 1000 ("105" = Rp105.000, "1225" = Rp1.225.000).
# Satuan eksplisit rb/ribu/k/jt/juta juga dikenali. Kulakan dan kas TIDAK
# diketik manual - keduanya dibaca dari ringkasan rekap yang dikirim bot
# sendiri ke grup REKAP_SUMMARY_GROUP_NAME.
KEUANGAN_GROUP_NAME=rekap harian
# Isi kalau nama grup ambigu; lebih pasti daripada mencocokkan nama.
KEUANGAN_GROUP_ID=
# Jumlah pesan terakhir yang ditelusuri di grup itu
KEUANGAN_HISTORY_COUNT=500
#
# --- Seller Centre Shopee (untuk tarik dana) ---
# Open API Shopee TIDAK punya endpoint penarikan, jadi tahap ini menyetir
# halaman Seller Centre. Login pertama kali lakukan manual sekali:
#   SHOPEE_SELLER_HEADLESS=false npm run cek:saldo
# Sesinya tersimpan di data/shopee-seller-profile dan dipakai run berikutnya.
SHOPEE_SELLER_USERNAME=
SHOPEE_SELLER_PASSWORD=
SHOPEE_SELLER_BALANCE_URL=https://seller.shopee.co.id/portal/finance/wallet/shopeepay
SHOPEE_SELLER_LOGIN_URL=https://seller.shopee.co.id/account/signin
# false = jendela terlihat. Pakai false saat login pertama / memperbaiki selektor.
SHOPEE_SELLER_HEADLESS=true
SHOPEE_SELLER_NAV_TIMEOUT_MS=60000
SHOPEE_SELLER_WITHDRAW_TIMEOUT_MS=120000
# Saat HEADLESS=false, skrip TIDAK mengisi form login sendiri - dia menunggu
# kamu login (termasuk OTP) di jendela Chrome yang terbuka selama ini.
SHOPEE_SELLER_MANUAL_TIMEOUT_MS=300000
# Batas aman: saldo di atas nilai ini membatalkan penarikan dan melapor, karena
# nominal ganjil lebih mungkin salah baca halaman daripada benar-benar ada.
# 0 = tanpa batas.
KEUANGAN_MAX_WITHDRAW=0
# true = seluruh alur jalan tapi tombol Tarik Dana tidak pernah ditekan.
# Pakai ini untuk memverifikasi selektor tanpa memindahkan uang.
KEUANGAN_DRY_RUN=false

# Jam batas hari kerja. Jam 00:00 s/d jam ini masih dihitung hari sebelumnya,
# supaya rekap yang dikerjakan lewat tengah malam tetap masuk blok hari itu.
# 0 = matikan (ikut tanggal kalender apa adanya).
KEUANGAN_DAY_CUTOFF_HOUR=4

# Tujuan penarikan yang diharapkan (dicocokkan sebagai regex). Halaman Tarik
# Dana juga menawarkan ShopeePay, dan salah tujuan tidak bisa dibatalkan -
# kalau yang terpilih tidak cocok, penarikan dibatalkan dan dilaporkan.
SHOPEE_SELLER_WITHDRAW_TO=SeaBank
# PIN 6 digit konfirmasi penarikan. BUKAN kata sandi akun.
# Kosong = penarikan berhenti di popup PIN dan harus diselesaikan manual.
SHOPEE_SELLER_WITHDRAW_PIN=

