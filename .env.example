WPP_SESSION=business-bot
BUSINESS_PHONE=6281234567890
WELCOME_MENU_MODE=list
TEXT_MENU_FALLBACK=false
PUPPETEER_HEADLESS=true
CHROME_PATH=
GOOGLE_SHEET_ID=1p1fULilLrZHNhIICW3qM4lF76YT3lSDXBGP4852OOvw
GOOGLE_SHEET_NAME=Template pembayaran
GOOGLE_SHEET_GID=1828439131
RECAP_FORMAT=jpg
RECAP_TIMEZONE=Asia/Makassar
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Shopee Open API v2 — production: https://partner.shopeemobile.com
SHOPEE_HOST=https://partner.shopeemobile.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=
SHOPEE_SHOP_ID=
# Dipakai sebagai seed awal saja; token yang dipakai runtime disimpan di data/shopee-token.json
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_SHEET_NAME=Harga Shopee
HARGA_TERBARU_SHEET_NAME=Harga Terbaru
# Status produk yang ditarik saat npm run ambil:harga — NORMAL, UNLIST, BANNED, REVIEWING
SHOPEE_IMPORT_ITEM_STATUS=NORMAL,UNLIST
# Noise reduction video — engine: arnndn (AI/RNNoise, default) atau afftdn
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=
VIDEO_DENOISE_ENGINE=arnndn
VIDEO_DENOISE_MODEL=./assets/sh.rnnn
# 1 = denoise penuh, 0.85 menyisakan 15% sinyal asli supaya suara tidak terdengar hampa
VIDEO_DENOISE_MIX=1
VIDEO_DENOISE_POLISH=false
# Pulihkan kecerahan kalau suara terdengar berat/tumpul: coba 3 atau 5
VIDEO_DENOISE_TREBLE=0
# Hanya dipakai engine afftdn
VIDEO_DENOISE_NR=12
VIDEO_DENOISE_LOUDNORM=true
# Batas atas bitrate audio hasil; sumber di bawah nilai ini tidak akan dinaikkan
VIDEO_DENOISE_AUDIO_KBPS=128
VIDEO_MAX_MB=16
VIDEO_MAX_OUTPUT_MB=16
VIDEO_JOB_TIMEOUT_MS=300000
# DeepFilterNet (engine=deepfilternet) — binary di bin/, tidak di-commit
DEEPFILTER_PATH=
# 100 = penekanan penuh, turunkan (mis. 25) kalau hasilnya terdengar tidak natural
VIDEO_DENOISE_ATTEN_DB=100
VIDEO_DENOISE_DFN_POSTFILTER=false
# post-filter beta DeepFilterNet: default 0.02, naikkan (0.05/0.10/0.20) kalau
# kurang bersih. Cek pakai telinga lewat npm run uji:noise, bukan cuma angka.
VIDEO_DENOISE_DFN_PF_BETA=0.02
# voicecleaner.ai (engine=voicecleaner). Situsnya wajib login dan memakai kredit
# harian, jadi fitur berhenti saat kuota habis. Isi VOICECLEANER_FALLBACK_ENGINE
# supaya bot tetap membalas hasil saat itu terjadi; kosongkan untuk mematikannya.
VOICECLEANER_EMAIL=
VOICECLEANER_PASSWORD=
VOICECLEANER_FALLBACK_ENGINE=deepfilternet
VOICECLEANER_ENHANCEMENT=Remove Noise
VOICECLEANER_TIMEOUT_MS=300000
# true = jalan tanpa jendela. Set false saat memperbaiki selektor supaya kelihatan.
VOICECLEANER_HEADLESS=true

# ===== Cek kilo (bandingkan foto catatan karyawan dengan report Bilas) =====
# Login pemilik ke aplikasi Bilas (web.bilas.id)
BILAS_USERNAME=
BILAS_PASSWORD=
# Cabang default bila perintah tidak menyebut cabang:<nama>. Kosong = outlet pertama.
BILAS_DEFAULT_OUTLET=
# Pembacaan foto pakai Claude vision via AWS Bedrock
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opsional bila pakai kredensial sementara (STS)
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Selisih kg yang masih dianggap cocok (default 0.3 kg)
KILO_TOLERANCE=0.3
# Batas ukuran foto masuk (MB)
KILO_MAX_MB=12
